    "rss-reader":{"main":[[{"node":"keyword-filter","type":"main","index":0}]]},
    "keyword-filter":{"main":[[{"node":"sentiment","type":"main","index":0}]]},
    "sentiment":{"main":[[{"node":"libretranslate","type":"main","index":0}]]},
    "libretranslate":{"main":[[{"node":"ollama-llm","type":"main","index":0}]]},
    "ollama-llm":{"main":[[{"node":"formatter","type":"main","index":0}]]},
    "formatter":{"main":[[{"node":"pdf-gen","type":"main","index":0},{"node":"tts-coqui","type":"main","index":0},{"node":"gmail","type":"main","index":0},{"node":"slack","type":"main","index":0},{"node":"telegram","type":"main","index":0},{"node":"archive","type":"main","index":0}]]}
  },
  "active":false,
