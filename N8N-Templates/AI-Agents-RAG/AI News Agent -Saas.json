          "string": [
            { "name": "title", "value": "={{ $json.title }}" },
            { "name": "link", "value": "={{ $json.link }}" },
            { "name": "content", "value": "={{ $json.contentSnippet || $json.content || '' }}" },
            { "name": "thumbnail", "value": "={{ $json.thumbnail || '' }}" },
            { "name": "sentiment", "value": "={{ $json.sentiment || 'neutral' }}" },
            { "name": "keywords", "value": "={{ JSON.stringify($json.keywords || []) }}" },
            { "name": "source", "value": "={{ $json.feedUrl || $json.source || '' }}" },
            { "name": "published", "value": "={{ $json.pubDate || $json.isoDate || '' }}" }
          ]
        }
      }
    },

    {
      "id": "ai-summarizer",
      "name": "AI Summary Agent (Langchain/Gemini) - Multi-style",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [1660, 320],
      "parameters": {
        "promptType": "define",
        "text": "=Summarize the following articles into a consolidated daily newsletter. Output language: {{ $jsonSettings.language || 'en' }}. Style: {{ $jsonSettings.summaryStyle || 'bullet' }}. Include source, published date, 2-sentence summary each, sentiment label, top keywords, and thumbnail links. Today's date: {{ $today }}. Articles: {{ JSON.stringify($items()) }}",
        "options": {}
      }
    },

    {
      "id": "set-output-format",
      "name": "Function - Format Final Newsletter (HTML/Text)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1860, 320],
      "parameters": {
        "functionCode": "const style = $items()[0].json.summaryStyle || 'bullet';\nconst language = $items()[0].json.language || 'en';\nconst articles = items.map((it)=>it.json);\nlet html = `<h1>Daily AI Summary - ${new Date().toLocaleDateString()}</h1>`;\nfor (const a of articles){\n  html += `<h2><a href=\\\"${a.link}\\\">${a.title}</a></h2>`;\n  html += `<p>${a.content}</p>`;\n  html += `<p><strong>Sentiment:</strong> ${a.sentiment} | <strong>Keywords:</strong> ${a.keywords}</p>`;\n  if(a.thumbnail) html += `<img src=\\\"${a.thumbnail}\\\" alt=\\\"thumb\\\" style=\\\"max-width:200px\\\"/>`;\n}\nreturn [{ json: { html, text: html.replace(/<[^>]+>/g,'') } }];"
      }
    },

