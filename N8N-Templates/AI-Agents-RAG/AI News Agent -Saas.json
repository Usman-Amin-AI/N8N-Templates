    {
      "id": "persist-user",
      "name": "Postgres: Persist User Preferences",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [-380, 120],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO users (user_id, email, channels, language, categories, rss_sources, delivery_time, summary_style, include_keywords, exclude_keywords, priority_weights) VALUES ({{ $json.userId ? `'${$json.userId}'` : 'DEFAULT' }}, '{{ $json.email }}', '{{ JSON.stringify($json.channels) }}', '{{ $json.language }}', '{{ JSON.stringify($json.categories) }}', '{{ JSON.stringify($json.rssSources) }}', '{{ $json.deliveryTime }}', '{{ $json.summaryStyle }}', '{{ JSON.stringify($json.includeKeywords) }}', '{{ JSON.stringify($json.excludeKeywords) }}', '{{ JSON.stringify($json.priorityWeights) }}') ON CONFLICT (user_id) DO UPDATE SET email=EXCLUDED.email, channels=EXCLUDED.channels;"
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CRED_ID",
          "name": "Postgres Account"
        }
      }
    },

    {
      "id": "expand-rss-list",
      "name": "Function - Expand RSS Sources",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [-200, 320],
      "parameters": {
        "functionCode": "const rss = $json.rssSources || ['https://www.theverge.com/rss/index.xml','https://feeds.bbci.co.uk/news/world/rss.xml'];\nreturn rss.map(u => ({ json: { url: u } }));"
      }
    },

    {
      "id": "rss-reader",
      "name": "RSS Feed Read (dynamic)",
      "type": "n8n-nodes-base.rssFeedReadTool",
      "typeVersion": 1.2,
      "position": [20, 320],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {}
      }
    },

    {
      "id": "filter-keywords",
      "name": "Function - Apply Keyword Include/Exclude & Category Filter",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [240, 320],
      "parameters": {
        "functionCode": "const include = $items()[0].json.includeKeywords || [];\nconst exclude = $items()[0].json.excludeKeywords || [];\nconst categories = $items()[0].json.categories || [];\n\nreturn items.filter(item => {\n  const title = (item.json.title || '').toLowerCase();\n  const content = (item.json.contentSnippet || item.json.content || '').toLowerCase();\n  // exclude\n  for (const ex of exclude) if ((title + ' ' + content).includes(ex.toLowerCase())) return false;\n  // include if include list non-empty\n  if (include.length > 0) {\n    let keep = false;\n    for (const inc of include) if ((title + ' ' + content).includes(inc.toLowerCase())) { keep = true; break; }\n    if (!keep) return false;\n  }\n  return true;\n});"
      }
    },

    {
      "id": "image-fetch",
      "name": "HTTP Request - Fetch OG image (thumbnail)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [460, 320],
      "parameters": {
        "url": "={{ $json.link }}",
        "responseFormat": "string",
        "options": {}
      }
    },

    {
      "id": "extract-image",
      "name": "Function - Extract OG image from HTML (placeholder)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [660, 320],
      "parameters": {
        "functionCode": "const html = items[0].binary ? '' : (items[0].json || {}).body || items[0].json;\n// Simple OG extractor fallback\nconst body = (items[0].json || {}).body || items[0].json;\nlet url = null;\nif (typeof body === 'string'){\n  const m = body.match(/<meta property=\\\"og:image\\\" content=\\\"([^\\\"]+)/i);\n  if(m) url = m[1];\n}\nreturn [{ json: { thumbnail: url || '' } }];"
      }
    },

    {
      "id": "sentiment-analysis",
      "name": "Function - Sentiment Scoring (simple)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [860, 320],
      "parameters": {
        "functionCode": "const txt = ($json.title || '') + ' ' + ($json.contentSnippet || $json.content || '');\n// Very basic sentiment placeholder — replace with AI classification node for production\nconst negative = ['death','crash','loses','loss','fail','accident','decline'];\nconst positive = ['surge','raise','gain','win','success','increase','record'];\nlet score = 0;\nfor (const w of negative) if (txt.toLowerCase().includes(w)) score -= 1;\nfor (const w of positive) if (txt.toLowerCase().includes(w)) score += 1;\nlet sentiment = 'neutral';\nif (score > 0) sentiment = 'positive';\nif (score < 0) sentiment = 'negative';\nreturn [{ json: { sentiment, sentimentScore: score } }];"
      }
    },

    {
      "id": "keywords-extract",
      "name": "Function - Extract Top Keywords",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1060, 320],
      "parameters": {
        "functionCode": "const text = ($json.title || '') + ' ' + ($json.contentSnippet || $json.content || '');\nconst words = text.toLowerCase().replace(/[^a-z0-9 ]+/g,' ').split(/\\s+/).filter(w => w.length>3);\nconst freq = {};\nfor(const w of words) freq[w] = (freq[w]||0)+1;\nconst keys = Object.keys(freq).sort((a,b)=>freq[b]-freq[a]).slice(0,5);\nreturn [{ json: { keywords: keys } }];"
      }
    },

    {
      "id": "rag-retrieval",
      "name": "HTTP Request - RAG Retrieval Placeholder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1260, 320],
      "parameters": {
        "url": "=https://your-vector-db.example/retrieve?query={{ encodeURIComponent($json.title || '') }}",
        "responseFormat": "json",
        "options": {}
      }
    },

