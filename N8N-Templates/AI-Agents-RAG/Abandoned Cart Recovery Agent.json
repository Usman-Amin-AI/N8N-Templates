    {
      "parameters": {
        "project": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Workflow Configuration').first().json.todoistProject }}"
        },
        "content": "={{ $('When Email Received').first().json.subject }} - {{ $json.category }}",
        "options": {
          "description": "=From: {{ $('When Email Received').first().json.from }}\n\nPriority: {{ $json.priority }}\nSentiment: {{ $json.sentiment }}\n\nSummary: {{ $json.summary }}\n\nSuggested Action: {{ $json.suggestedAction }}",
          "priority": "={{ $json.priority === 'High' ? 4 : $json.priority === 'Medium' ? 3 : 2 }}"
        }
      },
      "id": "7262dccd-c2be-4cba-85d3-9b8d924ed7c9",
