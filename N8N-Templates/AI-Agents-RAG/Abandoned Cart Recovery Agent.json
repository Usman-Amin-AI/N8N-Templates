    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a support email classification assistant.\n\nYour task is to analyze incoming support emails and extract the following information:\n1. Category: Classify the email into one of these categories: Technical Issue, Billing Question, Feature Request, General Inquiry, Complaint, or Other\n2. Priority: Determine urgency level as High, Medium, or Low based on:\n   - High: Critical system failures, security issues, payment problems, angry customers, urgent deadlines\n   - Medium: Non-critical bugs, account questions, feature requests with business impact\n   - Low: General questions, documentation requests, minor issues\n3. Sentiment: Analyze customer sentiment as Positive, Neutral, or Negative\n4. Summary: Provide a brief 1-2 sentence summary of the email content\n5. Suggested Action: Recommend next steps for handling this email\n\nAnalyze the email content carefully and return your classification."
        }
      },
      "id": "98308a76-393b-424e-97c6-8338062a6852",
      "name": "Email Classification Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        624,
        528
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "b6c83909-4192-4de1-a541-80b9f51b1a0f",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        624,
        752
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\"High\", \"Medium\", \"Low\"]\n    },\n    \"sentiment\": {\n      \"type\": \"string\",\n      \"enum\": [\"Positive\", \"Neutral\", \"Negative\"]\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"suggestedAction\": {\n      \"type\": \"string\"\n    }\n  }\n}"
      },
      "id": "08fe43a9-234d-4429-b035-13fada5b2a0c",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        768,
        752
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "id-1",
              "leftValue": "={{ $json.priority }}",
              "rightValue": "High",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "94522028-30e5-4997-b0bd-1e9fe519d522",
      "name": "Check If High Priority",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        976,
        528
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Workflow Configuration').first().json.slackChannel }}"
        },
        "text": "=🚨 *High Priority Support Email*\n\n*From:* {{ $('When Email Received').first().json.from }}\n*Subject:* {{ $('When Email Received').first().json.subject }}\n*Category:* {{ $json.category }}\n*Sentiment:* {{ $json.sentiment }}\n\n*Summary:* {{ $json.summary }}\n\n*Suggested Action:* {{ $json.suggestedAction }}",
        "otherOptions": {}
      },
      "id": "d9a026d7-3df2-4e8d-823e-65f5d7a9db1b",
      "name": "Send Slack Alert",
